{
  "name": "Java",
  "scopeName": "source.java",
  "fileTypes": ["java"],
  "patterns": [
    { "include": "#comment-line" },
    { "include": "#comment-block" },
    { "include": "#annotation" },
    { "include": "#string" },
    { "include": "#char" },
    { "include": "#keyword" },
    { "include": "#primitive-type" },
    { "include": "#constant" },
    { "include": "#number" },
    { "include": "#class-def" },
    { "include": "#method-call" }
  ],
  "repository": {
    "comment-line": {
      "name": "comment.line.double-slash.java",
      "match": "//.*$"
    },
    "comment-block": {
      "name": "comment.block.java",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "annotation": {
      "name": "storage.type.annotation.java",
      "match": "@[a-zA-Z_][a-zA-Z0-9_.]*"
    },
    "string": {
      "name": "string.quoted.double.java",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.java", "match": "\\\\." }]
    },
    "char": {
      "name": "string.quoted.single.java",
      "match": "'(\\\\.|[^'\\\\])'"
    },
    "keyword": {
      "name": "keyword.control.java",
      "match": "\\b(public|protected|private|class|interface|enum|extends|implements|import|package|static|final|abstract|return|if|else|for|while|do|switch|case|default|break|continue|try|catch|finally|throw|throws|new|this|super|instanceof|synchronized|volatile|transient|native|var|record|sealed|permits|yield)\\b"
    },
    "primitive-type": {
      "name": "storage.type.primitive.java",
      "match": "\\b(void|int|long|double|float|boolean|char|byte|short)\\b"
    },
    "constant": {
      "name": "constant.language.java",
      "match": "\\b(true|false|null)\\b"
    },
    "number": {
      "name": "constant.numeric.java",
      "match": "\\b(0x[0-9a-fA-F]+[lL]?|0b[01]+[lL]?|\\d+(\\.\\d+)?([eE][+-]?\\d+)?[fFdDlL]?)\\b"
    },
    "class-def": {
      "name": "entity.name.class.java",
      "match": "(?<=class |interface |enum )([a-zA-Z_][a-zA-Z0-9_]*)"
    },
    "method-call": {
      "name": "entity.name.function.java",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
    }
  }
}
