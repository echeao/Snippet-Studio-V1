{
  "name": "CSS",
  "scopeName": "source.css",
  "fileTypes": ["css", "scss", "less"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#at-rule" },
    { "include": "#rule-set" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.css",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "at-rule": {
      "name": "keyword.control.at-rule.css",
      "match": "@[a-zA-Z-]+"
    },
    "rule-set": {
      "name": "meta.ruleset.css",
      "patterns": [
        { "include": "#selector" },
        { "include": "#block" }
      ]
    },
    "selector": {
      "name": "entity.name.tag.css",
      "match": "[.#]?[a-zA-Z][a-zA-Z0-9_-]*(?=[^{]*\\{)"
    },
    "block": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#comment" },
        { "include": "#property" }
      ]
    },
    "property": {
      "patterns": [
        { "include": "#property-name" },
        { "include": "#property-value" },
        { "include": "#color-hex" },
        { "include": "#number-unit" },
        { "include": "#css-variable" },
        { "include": "#string-double" },
        { "include": "#string-single" }
      ]
    },
    "property-name": {
      "name": "support.type.property-name.css",
      "match": "[a-zA-Z-]+(?=\\s*:)"
    },
    "property-value": {
      "name": "support.constant.property-value.css",
      "match": "\\b(none|block|flex|grid|inline|inline-block|relative|absolute|fixed|sticky|bold|normal|pointer|auto|solid|dashed|dotted|transparent|center|left|right|top|bottom|cover|contain|nowrap|wrap|column|row|space-between|space-around|inherit|initial|unset|revert|hidden|visible|scroll|clip)\\b"
    },
    "color-hex": {
      "name": "constant.other.color.rgb-value.css",
      "match": "#[0-9a-fA-F]{3,8}\\b"
    },
    "number-unit": {
      "name": "constant.numeric.css",
      "match": "-?\\d+(\\.\\d+)?(px|em|rem|vh|vw|%|pt|pc|cm|mm|in|ex|ch|vmin|vmax|fr|deg|rad|turn|s|ms)?"
    },
    "css-variable": {
      "name": "variable.css",
      "match": "--[a-zA-Z][a-zA-Z0-9_-]*|var\\(--[a-zA-Z][a-zA-Z0-9_-]*\\)"
    },
    "string-double": {
      "name": "string.quoted.double.css",
      "begin": "\"",
      "end": "\""
    },
    "string-single": {
      "name": "string.quoted.single.css",
      "begin": "'",
      "end": "'"
    }
  }
}
